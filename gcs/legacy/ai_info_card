"""HEDEF GOREV BILGILERI - AI ciktilarini gosteren kart."""
from PySide6.QtCore import Qt, Slot
from PySide6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel, QFrame, QGridLayout,
    QProgressBar,
)


class AiInfoCard(QFrame):
    """AI hedef tespiti verilerini sergiler. ai_results_receiver'dan
    veya manuel `update_data(...)` ile beslenir."""
    
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("VeriKarti")
        self._build_ui()
        self._reset_values()
    
    def _build_ui(self):
        self.setStyleSheet("""
            #VeriKarti {
                background-color: #151b26;
                border: 2px solid #0fb9b1;
                border-radius: 15px;
            }
            QLabel { background: transparent; border: none; }
        """)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(15)
        
        # Baslik
        title = QLabel("🎯 HEDEF GOREV BILGILERI")
        title.setStyleSheet(
            "color: #0fb9b1; font-size: 22px; font-weight: 900; letter-spacing: 1px;"
        )
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)
        
        sep = QFrame(); sep.setFrameShape(QFrame.HLine)
        sep.setStyleSheet("border: 1px solid #2d3436;")
        layout.addWidget(sep)
        
        # Grid: etiket -> deger
        grid = QGridLayout()
        grid.setVerticalSpacing(18)
        s_label = "color: #7f8fa6; font-size: 16px; font-weight: bold;"
        s_value = "color: #f5f6fa; font-size: 18px; font-weight: bold;"
        s_emph  = "color: #feca57; font-size: 20px; font-weight: 900;"
        
        self._lbl_konum = QLabel("Bekleniyor...")
        self._lbl_konum.setStyleSheet(s_value)
        self._lbl_konum.setAlignment(Qt.AlignRight)
        grid.addWidget(self._mk_label("📍 Konum", s_label), 0, 0)
        grid.addWidget(self._lbl_konum, 0, 1)
        
        self._lbl_mesafe = QLabel("-")
        self._lbl_mesafe.setStyleSheet(s_emph)
        self._lbl_mesafe.setAlignment(Qt.AlignRight)
        grid.addWidget(self._mk_label("📏 Mesafe", s_label), 1, 0)
        grid.addWidget(self._lbl_mesafe, 1, 1)
        
        self._lbl_yayilim = QLabel("-")
        self._lbl_yayilim.setStyleSheet(s_emph)
        self._lbl_yayilim.setAlignment(Qt.AlignRight)
        grid.addWidget(self._mk_label("🧭 Yayilim Yonu", s_label), 2, 0)
        grid.addWidget(self._lbl_yayilim, 2, 1)
        
        layout.addLayout(grid)
        
        # AI guven skoru
        ai_title = QLabel("🧠 Yapay Zeka Guven Skoru")
        ai_title.setStyleSheet(s_label)
        ai_title.setAlignment(Qt.AlignCenter)
        layout.addWidget(ai_title)
        
        self._ai_bar = QProgressBar()
        self._ai_bar.setRange(0, 100)
        self._ai_bar.setValue(0)
        self._ai_bar.setAlignment(Qt.AlignCenter)
        self._ai_bar.setFixedHeight(25)
        self._ai_bar.setStyleSheet("""
            QProgressBar {
                border: 2px solid #2d3436; border-radius: 10px;
                background-color: #0b0f19; color: white;
                font-size: 14px; font-weight: bold;
            }
            QProgressBar::chunk {
                background-color: qlineargradient(
                    x1: 0, y1: 0, x2: 1, y2: 0,
                    stop: 0 #e67e22, stop: 1 #e74c3c);
                border-radius: 8px;
            }
        """)
        layout.addWidget(self._ai_bar)
    
    def _mk_label(self, text, style):
        lbl = QLabel(text); lbl.setStyleSheet(style); return lbl
    
    def _reset_values(self):
        self._lbl_konum.setText("Bekleniyor...")
        self._lbl_mesafe.setText("-")
        self._lbl_yayilim.setText("-")
        self._ai_bar.setValue(0)
    
    @Slot(dict)
    def update_data(self, data: dict):
        """ai_results_receiver'in `results_updated` sinyaline baglanir."""
        lat = data.get('target_lat')
        lon = data.get('target_lon')
        if lat is not None and lon is not None:
            self._lbl_konum.setText(f"{lat:.5f}, {lon:.5f}")
        
        if 'distance_m' in data:
            self._lbl_mesafe.setText(f"{int(data['distance_m'])} m")
        if 'spread_text' in data:
            angle = data.get('spread_angle', 0)
            self._lbl_mesafe.setText(f"{data['spread_text']} ({angle}°)")
        if 'confidence' in data:
            self._ai_bar.setValue(int(data['confidence']))
    
    def set_alarm_mode(self, active: bool):
        """Yangin tespit edilince kenarliği kirmiziya cek."""
        color = "#e74c3c" if active else "#0fb9b1"
        self.setStyleSheet(f"""
            #VeriKarti {{
                background-color: #151b26;
                border: 2px solid {color};
                border-radius: 15px;
            }}
            QLabel {{ background: transparent; border: none; }}
        """)